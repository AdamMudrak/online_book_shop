# Database
MYSQL_DATABASE=legimus_db
MYSQL_ROOT_PASSWORD=root
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/legimus_db?serverTimeZone=UTC
SPRING_DATASOURCE_USERNAME=legimus_user
SPRING_DATASOURCE_PASSWORD=legimus_pass
SPRING_DATASOURCE_TEST_URL=jdbc:tc:mysql:8://test_url
SPRING_LIQUIBASE_CHANGE_LOG=classpath:db/changelog/db.changelog-master.yaml

# Security
JWT_ACTION_EXPIRATION=600000
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_SECRET=local-development-jwt-secret-at-least-32-bytes

# Email
RESEND_API_KEY=dummy-resend-api-key
MAIL=no-reply@example.com

# App URLs
SERVER_PATH=http://localhost:8080
